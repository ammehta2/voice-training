# ============================================================
# Audio data — too large for git, regenerable from source
# ============================================================
# Source audio (in user's Music folder, not in repo)
data/positive_raw/
data/positive_raw_originals/
data/positive_raw_originals_v1/

# Pipeline outputs (regenerated from source by scripts)
data/positive_aug/
data/negative_raw/
data/negative_aug/
data/features/

# Pipeline subfolder outputs (opening + closing pipelines)
data/opening/
data/closing/

# v7 multi-phrase pipeline outputs (closing + pre-closing + shared negatives)
data/multi/

# v8 adversarial hard-negative corpus (synthetic Mangalam/Namo prayers)
data/hard_negatives/
data/real_world_test_v2/

# Test sets
data/partial_chants_test/
data/real_world_test/
data/speech_negative_test/

# Downloaded datasets
data/sources/

# Reference voice samples (provided by user)
voice_samples/*.wav
voice_samples/*.mp3
voice_samples/*.m4a
voice_samples/*.ogg

# ============================================================
# Trained models — selectively committed
# ============================================================
# Ignore everything in models/* by default
models/*/*

# But whitelist the deployable artifacts and training metadata.
# Mobile-deployable models (29 KB - 1.2 MB):
!models/*/*.tflite
# PyTorch checkpoints (~50 KB) for re-export / fine-tuning:
!models/*/best.pt
# Training history (small):
!models/*/training_curves.png
!models/*/history.npz

# Still ignored even with the whitelist above (too big / regenerable):
# - *.onnx (intermediate, can be regenerated from best.pt)
# - saved_model.pb + variables/ (TF SavedModel, intermediate)
# - calibration.npy (76 MB calibration data; regenerable from features)
# - final.pt (use best.pt instead)

# ============================================================
# Generated artifacts
# ============================================================
mel_filterbank.b64
logs/
*.log

# Tensorboard
runs/
events.out.tfevents.*

# Live device captures (user voice data — never commit)
data/live_captures/
